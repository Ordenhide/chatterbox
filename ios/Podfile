# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!
# React Native Firebase 26 resolves the Firebase iOS SDK through Swift Package
# Manager by default. firebase-ios-sdk's SPM products are automatic libraries
# rather than `type: .dynamic`, so under `use_frameworks! :linkage => :static`
# every RNFB pod embeds its own copy of Firebase and they collide at link time
# as duplicate symbols. RNFB detects the combination and refuses to generate
# the project at all.
#
# Of the two escapes it offers — dynamic linkage, or opting out of SPM — this
# is the conservative one. Switching to dynamic linkage would change how every
# pod in the project is built and would invalidate the static-linkage
# workarounds below (the gRPC modulemap handling in particular). Opting out of
# SPM keeps Firebase resolving through CocoaPods exactly as it did on RNFB 21,
# so $FirebaseSDKVersion below still governs the version.
$RNFirebaseDisableSPM = true
# React Native Firebase 26 is built against firebase-ios-sdk 12.x — its
# Firestore sources use the Pipeline API (StageBridge), which does not exist in
# 11.x. Pinning 11.15.0 here is what made RNFBFirestorePipelineBridgeFactory.swift
# fail with "cannot find type 'StageBridge' in scope".
$FirebaseSDKVersion = '12.17.0'
# New Architecture (Fabric + TurboModules), matching android/gradle.properties.
#
# Set here rather than exported, on purpose: macos/Podfile reads the same
# variable to decide `fabric_enabled`, and react-native-macos is not part of
# this migration. Keeping the assignment inside the iOS Podfile means a macOS
# `pod install` still resolves to the legacy renderer.
#
# Turning this on requires `self.dependencyProvider` in AppDelegate.mm — see the
# comment there. Without it the app builds and boots but renders blank, because
# every third-party Fabric component silently degrades to its legacy view
# manager. If this file and that one ever disagree, that is the symptom.
#
# Also worth knowing: RN 0.81 wires `bridgelessEnabled` directly to
# `newArchEnabled` (RCTRootViewFactory.mm), so Fabric-without-bridgeless is not
# an available fallback if something surfaces later.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# If you are using a `react-native-flipper` your iOS build will fail when `NO_FLIPPER=1` is set.
# because `react-native-flipper` depends on (FlipperKit,...) that will be excluded
#
# To fix this you can also exclude `react-native-flipper` using a `react-native.config.js`
# ```js
# module.exports = {
#   dependencies: {
#     ...(process.env.NO_FLIPPER ? { 'react-native-flipper': { platforms: { ios: null } } } : {}),
# ```

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'Chatterbox' do
  config = use_native_modules!

  # Every autolinked third-party module's podspec calls install_modules_dependencies(s)
  # (react-native/scripts/react_native_pods.rb), which — in this project/environment,
  # confirmed by instrumenting the helper directly — resolves
  # ReactNativeDependenciesUtils.build_react_native_deps_from_source() to true for
  # third-party modules even though the app otherwise correctly links the prebuilt
  # ReactNativeDependencies tarball. That takes the old source-mode branch and asks
  # for RCT-Folly plus its siblings (glog, boost, DoubleConversion, fast_float, fmt)
  # by name — specs nothing else registers a source for once the rest of the graph
  # resolves through the tarball. Registering all six explicitly here, pointing at
  # RN's own bundled copies, gives CocoaPods somewhere to find them; nothing else in
  # the graph ends up using them.
  #
  # RCT-Folly needs its `Fabric` subspec too — folly/synchronization/*.h (needed by
  # SanitizeThread.cpp, which the Default subspec compiles) is only declared under
  # Fabric, not Default. install_modules_dependencies itself adds this same subspec
  # when RCT_NEW_ARCH_ENABLED is set (it is, above) — we're just replicating that.
  %w[glog boost DoubleConversion fast_float fmt].each do |dep|
    pod dep, :podspec => "#{config[:reactNativePath]}/third-party-podspecs/#{dep}.podspec"
  end
  pod 'RCT-Folly', :podspec => "#{config[:reactNativePath]}/third-party-podspecs/RCT-Folly.podspec"
  pod 'RCT-Folly/Fabric', :podspec => "#{config[:reactNativePath]}/third-party-podspecs/RCT-Folly.podspec"

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ChatterboxTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # Prevent React Native from re-adding -ld_classic on Xcode 15+
    if defined?(ReactNativePodsUtils)
      ReactNativePodsUtils.singleton_class.send(:define_method, :apply_xcode_15_patch) do |*args, **_kwargs|
        Pod::UI.puts "Skipping ReactNativePodsUtils.apply_xcode_15_patch (ld_classic)".yellow
      end
    end

    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => true
    )

    # react-native-webrtc's precompiled JitsiWebRTC binary has no Mac Catalyst
    # slice (consistent with every current WebRTC fork lacking macOS/Catalyst
    # support). Calls are out of scope for the Mac build for now — exclude
    # just these two pods from the Catalyst variant; regular iOS device/
    # simulator builds are unaffected.
    installer.pods_project.targets.each do |target|
      if ['react-native-webrtc', 'JitsiWebRTC'].include?(target.name)
        target.build_configurations.each do |build_config|
          build_config.build_settings['SUPPORTS_MACCATALYST'] = 'NO'
          # SUPPORTS_MACCATALYST alone doesn't drop the target from the
          # aggregate build graph — it still gets compiled (with broken
          # header search paths). Excluding its archs for the macosx/Catalyst
          # SDK is what actually skips compiling it for that destination.
          build_config.build_settings['EXCLUDED_ARCHS[sdk=macosx*]'] = 'arm64 x86_64'
        end
      end
    end

    # Xcode's module verifier compiles each pod's headers on their own to check
    # the generated modulemap. CocoaPods 1.17 turns it on for every pod that
    # sets DEFINES_MODULE, and its default language is Objective-C — so a C++
    # library gets compiled as ObjC and stops at the first C++ include. glog is
    # the one that trips: logging.h line 42 includes <iosfwd>, which does not
    # exist in that language, and the build fails with 'iosfwd' file not found.
    # Nothing is wrong with glog; the verifier is being asked in the wrong
    # language.
    #
    # This only appears on the Mac's own architecture. Verification is skipped
    # for a non-native slice, so an x86_64 simulator build on an Apple Silicon
    # machine goes green while Xcode's arm64 build of the same commit goes red.
    # If you are ever tempted to trust a CLI build here, that is why not.
    CXX_ONLY_PODS = ['glog'].freeze
    installer.pods_project.targets.each do |target|
      next unless CXX_ONLY_PODS.include?(target.name)
      target.build_configurations.each do |build_config|
        build_config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGES'] = 'objective-c++ c++'
      end
    end

    # Align pods to a supported iOS deployment target to silence warnings
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        # 15.0, not 14.0: React Native Firebase 26 declares iosTarget 15.0, and
        # forcing every pod below its own floor is how you get missing-symbol
        # errors at link time rather than a clear version complaint.
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        build_config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        # Required since the React Native 0.84 upgrade.
        #
        # React Native Firebase's headers (RNFBAppModule.h and friends) import
        # React-Core headers like RCTBridgeModule.h with plain #import rather
        # than through a module. Under `use_frameworks!` each pod is a
        # framework module, and clang treats a non-modular include inside one
        # as -Wnon-modular-include-in-framework-module — which Xcode's explicit
        # module precompilation (the `PrecompileModule ... .scan` build step)
        # promotes to an error. Ten RNFBApp headers fail this way, which stops
        # the build before anything links.
        #
        # This is React Native Firebase's to fix upstream; until then the
        # warning has to be allowed, and allowing it is what every
        # use_frameworks + RNFB project does.
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        other_ldflags = build_config.build_settings['OTHER_LDFLAGS']
        if other_ldflags.is_a?(Array)
          build_config.build_settings['OTHER_LDFLAGS'] = other_ldflags.reject { |flag| flag == '-ld_classic' || flag == '-Wl' }
        elsif other_ldflags.is_a?(String)
          build_config.build_settings['OTHER_LDFLAGS'] = other_ldflags.gsub('-Wl -ld_classic', '').strip
        end
      end
    end

    # Also scrub -ld_classic from the user project to prevent Xcode re-adding it.
    installer.aggregate_targets.each do |agg|
      agg.user_project.native_targets.each do |target|
        target.build_configurations.each do |build_config|
          other_ldflags = build_config.build_settings['OTHER_LDFLAGS']
          if other_ldflags.is_a?(Array)
            cleaned = other_ldflags.reject { |flag| flag == '-ld_classic' || flag == '-Wl' }
            build_config.build_settings['OTHER_LDFLAGS'] = cleaned.empty? ? ['$(inherited)'] : cleaned
          elsif other_ldflags.is_a?(String)
            cleaned = other_ldflags.gsub('-Wl -ld_classic', '').strip
            build_config.build_settings['OTHER_LDFLAGS'] = cleaned.empty? ? '$(inherited)' : cleaned
          end
        end
      end
    end

    # Ensure gRPC targets compile with C++17 even if they override settings
    installer.pods_project.targets.each do |target|
      if ['gRPC-Core', 'gRPC-C++', 'gRPC'].include?(target.name)
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
          build_config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -std=c++20'
          build_config.build_settings['MODULEMAP_FILE'] = '$(PODS_ROOT)/Target Support Files/gRPC-Core/gRPC-Core.modulemap'
        end
      end
    end

    # Work around missing gRPC-Core modulemap path in some Xcode/toolchain combos
    begin
      require 'fileutils'
      modulemap_src = "#{installer.sandbox.root}/Target Support Files/gRPC-Core/gRPC-Core.modulemap"
      private_dirs = [
        "#{installer.sandbox.root}/Headers/Private/grpc",
        "#{installer.sandbox.root}/Headers/Private/gRPC",
      ]
      if File.exist?(modulemap_src)
        private_dirs.each do |dir|
          FileUtils.mkdir_p(dir)
          dst = File.join(dir, 'gRPC-Core.modulemap')
          FileUtils.cp(modulemap_src, dst)
          FileUtils.ln_sf(modulemap_src, dst)
        end
      end
    rescue => e
      Pod::UI.puts "gRPC modulemap copy skipped: #{e}"
    end
  end
end
