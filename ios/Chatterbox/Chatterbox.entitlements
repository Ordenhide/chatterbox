<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty. com.apple.developer.applesignin lived here until
	     Sign in with Apple was removed; an app that claims a capability it does
	     not use is a question at review and a permission it cannot justify.
	     The file stays so the Xcode project reference and the signing
	     configuration that points at it keep resolving. -->
</dict>
</plist>
