rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function pairId(userA, userB) {
      return userA < userB ? userA + "_" + userB : userB + "_" + userA;
    }

    function isFriend(userA, userB) {
      return exists(/databases/$(database)/documents/friends/$(pairId(userA, userB)));
    }

    function blockId(blockerId, blockedId) {
      return blockerId + "_" + blockedId;
    }

    function isBlocked(blockerId, blockedId) {
      return exists(/databases/$(database)/documents/blocks/$(blockId(blockerId, blockedId)));
    }

    function canReadMomentById(momentId) {
      let moment = get(/databases/$(database)/documents/moments/$(momentId));
      return isSignedIn() && (
        moment.data.authorId == request.auth.uid ||
        moment.data.visibility == "public" ||
        (moment.data.visibility == "friends" && isFriend(request.auth.uid, moment.data.authorId))
      ) &&
      !isBlocked(request.auth.uid, moment.data.authorId) &&
      !isBlocked(moment.data.authorId, request.auth.uid);
    }

    function canReadMomentResource() {
      return isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.visibility == "public" ||
        (resource.data.visibility == "friends" && isFriend(request.auth.uid, resource.data.authorId))
      ) &&
      !isBlocked(request.auth.uid, resource.data.authorId) &&
      !isBlocked(resource.data.authorId, request.auth.uid);
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function canReadUserProfile(userId) {
      return request.auth.uid == userId ||
        (resource.data.profileVisibility == "friends" && isFriend(request.auth.uid, userId)) ||
        (isSignedIn() && (resource.data.profileVisibility == "public" || resource.data.profileVisibility == null));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.fromId &&
        request.resource.data.toId is string &&
        request.resource.data.status == "pending" &&
        !isBlocked(request.auth.uid, request.resource.data.toId) &&
        !isBlocked(request.resource.data.toId, request.auth.uid);
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
    }

    match /friends/{friendId} {
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.userIds &&
        request.resource.data.status == "accepted" &&
        request.resource.id == pairId(request.resource.data.userIds[0], request.resource.data.userIds[1]) &&
        !isBlocked(request.resource.data.userIds[0], request.resource.data.userIds[1]) &&
        !isBlocked(request.resource.data.userIds[1], request.resource.data.userIds[0]);
      allow update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.userIds;
    }

    match /moments/{momentId} {
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid;
      allow read: if canReadMomentResource();
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (canReadMomentById(momentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']))
      );
      allow delete: if isSignedIn() &&
        resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if canReadMomentById(momentId);
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if canReadMomentById(momentId);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
      }
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.blockerId &&
        request.resource.id == blockId(request.resource.data.blockerId, request.resource.data.blockedId);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.blockerId;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
    }

    match /chats/{chatId} {
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isChatParticipant(chatId);
        allow update, delete: if isChatParticipant(chatId);
      }

      match /calls/{callId} {
        allow read, write: if isChatParticipant(chatId);

        match /candidates/{candidateId} {
          allow read, write: if isChatParticipant(chatId);
        }
      }

      match /scheduledMessages/{msgId} {
        allow read, create: if isChatParticipant(chatId);
        allow update, delete: if isChatParticipant(chatId);
      }

      match /sharedLists/{listId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /expenses/{expenseId} {
        allow read, create: if isChatParticipant(chatId);
        allow update, delete: if isChatParticipant(chatId);
      }

      match /liveLocations/{userId} {
        allow read: if isChatParticipant(chatId);
        allow write: if isChatParticipant(chatId) && request.auth.uid == userId;
      }

      match /whiteboards/{whiteboardId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /quoteWall/{quoteId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /rituals/{ritualId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /playlist/{trackId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /countdowns/{countdownId} {
        allow read, write: if isChatParticipant(chatId);
      }
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
