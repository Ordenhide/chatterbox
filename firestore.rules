rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enforces that a request actually comes from the account's most
    // recently claimed session, not just any still-technically-valid token.
    //
    // Session takeover (see services/session.ts on both clients) was
    // previously enforced only client-side: the displaced device's own
    // real-time listener notices activeSessionId changed and signs itself
    // out. Nothing server-side backed that up — a device that's offline, or
    // whose listener doesn't fire, kept full read/write access on its
    // already-issued token for the rest of that token's ~1hr life.
    //
    // The obvious fix — compare request.auth.token.sessionId (a custom claim
    // set by the claimSession Cloud Function) against activeSessionId —
    // doesn't actually work: custom claims live on the *account*, not the
    // device, so any client's background token refresh (which happens
    // silently, without the user doing anything, and is *required* SDK
    // behavior near a token's expiry) picks up whatever the *current* claim
    // is regardless of whether that client did the claiming. Verified
    // empirically against the Auth emulator: a claim's custom claim shows up
    // in another device's very next refresh. That would close this gap for
    // about an hour and then silently reopen it.
    //
    // auth_time does not have that problem: it reflects when the token's
    // owner last *actually authenticated* (password sign-in), and is stable
    // across silent refreshes — also verified empirically, not assumed.
    // Comparing it against sessionClaimedAt (written by claimSession in the
    // same request that sets the custom claim) distinguishes "this device
    // (re)authenticated at or after the last claim" from "this device
    // silently refreshed a token minted long before it". The 120s grace
    // window covers the network round-trip between a real sign-in and the
    // claimSession call that immediately follows it — both clients await
    // that call before proceeding, but the two are still separate requests.
    //
    // No claim ever recorded (sessionClaimedAt absent, or no profile doc at
    // all — an account that predates this check, or a request racing sign-up
    // before the profile doc is written) is NOT enforced: this only starts
    // applying to an account from its first claim onward, so deploying it
    // doesn't retroactively lock out every already-signed-in session.
    function hasCurrentSession(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let profile = exists(path) ? get(path).data : null;
      return profile == null ||
        !('sessionClaimedAt' in profile) ||
        request.auth.token.auth_time >= profile.sessionClaimedAt.toMillis() / 1000 - 120;
    }

    function isSignedIn() {
      return request.auth != null && hasCurrentSession(request.auth.uid);
    }

    function pairId(userA, userB) {
      return userA < userB ? userA + "_" + userB : userB + "_" + userA;
    }

    function isFriend(userA, userB) {
      return exists(/databases/$(database)/documents/friends/$(pairId(userA, userB)));
    }

    function blockId(blockerId, blockedId) {
      return blockerId + "_" + blockedId;
    }

    function isBlocked(blockerId, blockedId) {
      return exists(/databases/$(database)/documents/blocks/$(blockId(blockerId, blockedId)));
    }

    function canReadMomentById(momentId) {
      let moment = get(/databases/$(database)/documents/moments/$(momentId));
      return isSignedIn() && (
        moment.data.authorId == request.auth.uid ||
        moment.data.visibility == "public" ||
        (moment.data.visibility == "friends" && isFriend(request.auth.uid, moment.data.authorId))
      ) &&
      !isBlocked(request.auth.uid, moment.data.authorId) &&
      !isBlocked(moment.data.authorId, request.auth.uid);
    }

    function canReadMomentResource() {
      return isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.visibility == "public" ||
        (resource.data.visibility == "friends" && isFriend(request.auth.uid, resource.data.authorId))
      ) &&
      !isBlocked(request.auth.uid, resource.data.authorId) &&
      !isBlocked(resource.data.authorId, request.auth.uid);
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{userId} {
      // A signed-in user can read a profile they can *name*, and cannot ask for
      // a list of them. `get` and `list` are separate permissions, and only the
      // second is what makes a collection a directory: with `list` denied there
      // is no query — by email, by name, or unfiltered — that returns anyone,
      // so knowing a uid is the only way to read a profile, and a uid is
      // something you get by already being in a chat with someone.
      //
      // This used to be a bare `read`, allowing both, because "new chat by
      // email" queried this collection. That entry point is gone (invite links,
      // services/invites.ts), and so are getUserByEmail and
      // searchUsersByEmailOrName on both clients. Nothing left needs a query
      // here — services/firebaseChat.ts reads profiles one document at a time
      // for exactly this reason. Restoring `list` would restore the directory.
      //
      // Reading *your own* profile deliberately requires only authentication,
      // not a current session. isSignedIn() folds in hasCurrentSession(), so a
      // displaced client — one whose session was claimed by a newer sign-in —
      // fails every rule in this file, including this one. That locked it out of
      // the single document that would tell it it had been displaced:
      // listenForSessionTakeover (services/session.ts) exists to notice exactly
      // that and sign the user out with an explanation, and it was being denied
      // by the rule it was trying to observe. The user saw a wall of
      // permission-denied errors and an app that looked broken instead.
      //
      // The carve-out leaks nothing: it is your own document, readable only by
      // you, and the fields it exposes (activeSessionId, sessionClaimedAt) are
      // precisely what a displaced client needs to conclude it has been
      // displaced. Writes still require a current session, so a stale client
      // cannot reclaim itself by writing.
      allow get: if isSignedIn() ||
        (request.auth != null && request.auth.uid == userId);
      allow list: if false;
      // Owning the document is not enough on its own, because two of its
      // fields are *identity claims* that other users act on. See
      // identityFieldsHonest().
      allow write: if isSignedIn() && request.auth.uid == userId &&
        identityFieldsHonest(userId);
    }

    /**
     * Stops a profile from carrying an identity it should not have, and from
     * claiming a uid that is not its own.
     *
     * `email` used to be *validated* here rather than refused, because it was
     * what "add friend" and "new chat" searched on: any user could set their
     * profile email to someone else's, and a victim searching for that address
     * found the impersonator and started an encrypted chat with them.
     * Trust-on-first-use does not flag a first contact — every key is unseen
     * once — so the conversation came up correctly encrypted, to the wrong
     * person. The encryption was never broken; the identity layer under it was
     * bypassed, by an ordinary user rather than a hostile server.
     *
     * The search is gone (invite links), so the field has no purpose left, and
     * a real-world identifier readable by everyone who knows your uid — which
     * is everyone you have shared a group with — is worth more to an attacker
     * than most of what it sits beside. `photoURL` goes with it: a Storage URL
     * with the same audience and no expiry.
     *
     * ## Why this forbids *changing* them rather than *having* them
     *
     * A rule that refused any document containing an email would refuse every
     * write by an account that already has one — `request.resource.data` is
     * the whole post-write document, so an update touching only a session id
     * still carries the stored email through the check. Existing accounts
     * would have been locked out of their own profile at the next sign-in,
     * which is the same trap the validating version of this rule was written
     * to avoid.
     *
     * So: neither field may be introduced or changed, and a create may not
     * carry them at all. An account that already has one keeps working and
     * clears it the next time its owner opens the app — both clients write
     * `deleteField()` for both on every sign-in (upsertUserProfile in
     * services/firebaseChat.ts), which is a change this rule allows because it
     * removes the field rather than setting it.
     *
     * The impersonation is closed either way: a value that can never be
     * introduced or altered is one that was already checked against the auth
     * token when it was written.
     *
     * `uid` is still checked rather than refused, because it is genuinely
     * used: a uid that disagrees with the document it sits in redirects
     * whoever acts on it.
     */
    function identityFieldsHonest(userId) {
      // Deletes carry no resource to inspect.
      return request.resource == null || (
        unchangedOrAbsent('email') &&
        unchangedOrAbsent('photoURL') &&
        (!('uid' in request.resource.data) ||
          request.resource.data.uid == userId)
      );
    }

    /** True when `field` is absent after the write, or exactly what it already was. */
    function unchangedOrAbsent(field) {
      return !(field in request.resource.data) || (
        resource != null &&
        request.resource.data.get(field, null) == resource.data.get(field, null)
      );
    }

    match /friendRequests/{requestId} {
      // get: the sender's transaction reads friendRequests/{pairId} to check for
      // a duplicate; that doc doesn't exist yet, so allow reading a missing doc
      // (resource == null) — otherwise the read is denied and the send fails.
      allow get: if isSignedIn() &&
        (resource == null ||
         request.auth.uid == resource.data.fromId ||
         request.auth.uid == resource.data.toId);
      // list: the incoming (toId == me) / outgoing (fromId == me) request
      // listeners. Kept separate so `resource == null` never enters the query
      // authorization analysis (a query's resource is always a real document).
      allow list: if isSignedIn() &&
        (request.auth.uid == resource.data.fromId ||
         request.auth.uid == resource.data.toId);
      // The document id must be the canonical pair id, and the two parties
      // must differ. Neither was checked, so requests could be created at
      // arbitrary ids naming arbitrary pairs — which mattered once the
      // friends rule below started reading a request to decide whether a
      // friendship was consented to. A lookup is only as trustworthy as the
      // addressing that led to it.
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.fromId &&
        request.resource.data.toId is string &&
        request.resource.data.toId != request.resource.data.fromId &&
        request.resource.id == pairId(request.resource.data.fromId, request.resource.data.toId) &&
        request.resource.data.status == "pending" &&
        !isBlocked(request.auth.uid, request.resource.data.toId) &&
        !isBlocked(request.resource.data.toId, request.auth.uid);
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
    }

    /**
     * Proves the other party actually asked to be friends.
     *
     * Both clients check this — acceptFriendRequest returns early unless the
     * request is addressed to the caller — but that is client-side only, and
     * the rules did not back it up. A friendship document could therefore be
     * written directly, with no request and no consent from the other person,
     * simply by naming them in `userIds`.
     *
     * That is not a cosmetic "friend" badge. `isFriend()` is what gates
     * friends-only moments, and now their images too, so a self-granted
     * friendship was a way to read another account's friends-only posts. The
     * visibility checks above were correct; the thing they consulted was not.
     *
     * Only the *recipient* of a pending request may create the friendship,
     * which is what makes it consent rather than assertion. The sender cannot,
     * however many requests they send.
     *
     * The client accepts inside a transaction that also deletes the request.
     * Rules read committed state, so the request is still there when this
     * evaluates.
     *
     * Being exact about the two comparisons, since it is easy to read them as
     * two independent defences: once friendRequests are pinned to the
     * canonical pair id, they are *mutually* redundant. The id fixes which two
     * accounts the request is between, and a request has exactly one sender
     * and one recipient, so "it came from the other party" and "it was
     * addressed to me" are the same statement. Mutating out either one alone
     * leaves the test suite green; mutating out both does not.
     *
     * Both are kept because together they say the property in full, and
     * because either would become load-bearing on its own if the id constraint
     * were relaxed. Neither is carrying the check by itself today.
     */
    function acceptingOwnRequest(userIds) {
      let other = userIds[0] == request.auth.uid ? userIds[1] : userIds[0];
      let pending = get(/databases/$(database)/documents/friendRequests/$(pairId(request.auth.uid, other)));
      return pending != null &&
        pending.data.toId == request.auth.uid &&
        pending.data.fromId == other;
    }

    match /friends/{friendId} {
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if isSignedIn() &&
        request.resource.data.userIds.size() == 2 &&
        request.resource.data.userIds[0] != request.resource.data.userIds[1] &&
        request.auth.uid in request.resource.data.userIds &&
        request.resource.data.status == "accepted" &&
        request.resource.id == pairId(request.resource.data.userIds[0], request.resource.data.userIds[1]) &&
        acceptingOwnRequest(request.resource.data.userIds) &&
        !isBlocked(request.resource.data.userIds[0], request.resource.data.userIds[1]) &&
        !isBlocked(request.resource.data.userIds[1], request.resource.data.userIds[0]);
      // No update: nothing in either client ever edits a friendship, and an
      // unconstrained update let either party rewrite `userIds` — leaving a
      // document that claims a pairing its own id contradicts. Unfriending is
      // a delete, which either party may do.
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.userIds;
    }

    match /moments/{momentId} {
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid;
      allow read: if canReadMomentResource();
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (canReadMomentById(momentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']))
      );
      allow delete: if isSignedIn() &&
        resource.data.authorId == request.auth.uid;

      /**
       * Reading a moment and writing to it were gated differently, and only
       * the read side asked whether you were allowed near it at all.
       *
       * canReadMomentById() carries the whole visibility model — author,
       * public, friends-only — and blocks in both directions. It was applied
       * to `read` on both subcollections and to neither `create`. So any
       * signed-in user could like or comment on a moment they could not see:
       * a private one, a friends-only one belonging to a stranger, or one
       * whose author had blocked them. The author could not read the
       * commenter's own profile, but the comment landed on their post and
       * they saw it.
       *
       * Blocking is precisely the control that is supposed to stop that, and
       * this was the last place it did nothing. The realistic route in needs
       * no id guessing: comment on a public moment, get blocked, keep
       * commenting — you already know the id.
       *
       * Delete stays ungated on purpose. Removing your own like or your own
       * comment must keep working after you lose read access, or losing access
       * strands your data somewhere you can never take it back from.
       */
      match /likes/{userId} {
        allow read: if canReadMomentById(momentId);
        allow create: if isSignedIn() && request.auth.uid == userId &&
          canReadMomentById(momentId);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if canReadMomentById(momentId);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId &&
          canReadMomentById(momentId);
        // The moment's author may delete too. Without that, a comment on your
        // own post could only ever be removed by the person who left it —
        // which, for the case this rule block exists to handle, is nobody.
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorId
        );
      }
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.blockerId &&
        request.resource.id == blockId(request.resource.data.blockerId, request.resource.data.blockedId);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.blockerId;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
    }

    /**
     * Abuse reports, the counterpart to deletion being author-only: you
     * cannot erase someone else's message, but you can report it.
     *
     * Write-only from the client, like /feedback. A report names another
     * user, so letting clients read this collection would turn it into a way
     * to discover who has been reported — and letting them update or delete
     * would let a reported user erase the report about them.
     *
     * The content field is the reporter's *decrypted* copy of what they saw.
     * That is unavoidable rather than careless: the server holds only
     * ciphertext it has no key for, so a report carrying nothing but a message
     * id would be unactionable. It is a real disclosure, so the client asks
     * for explicit confirmation and says so plainly before sending — see
     * reportMessage() in services/reports.ts.
     *
     * The reporter must be a participant of the chat they are reporting from,
     * which stops the collection from being used to file reports about
     * conversations the reporter cannot see.
     */
    match /messageReports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        isChatParticipant(request.resource.data.chatId) &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 40 &&
        request.resource.data.get('content', '') is string &&
        request.resource.data.get('content', '').size() <= 4000;
      allow read, update, delete: if false;
    }

    match /chats/{chatId} {
      // Mirrors MAX_GROUP_MEMBERS in services/e2ee.ts. Enforced here as well as
      // in the client because the client-side cap is a product guardrail, not a
      // security boundary — anyone can write to Firestore directly.
      function withinMemberCap(members) {
        return members.size() <= 32;
      }

      // Who this update drops from the member list.
      function removedMembers() {
        return resource.data.participants.toSet()
          .difference(request.resource.data.participants.toSet());
      }

      /**
       * Membership may grow freely, but the only person you can remove is
       * yourself.
       *
       * Without this, any participant could rewrite `participants` outright —
       * removing everyone else, or adding a stranger who then decrypts every
       * subsequent message (the sender fans out to whoever is listed here, so
       * this array *is* the access-control list for the encryption).
       *
       * Removing others is left out deliberately rather than forgotten: there
       * are no admin roles yet, so "anyone may remove anyone" would be the only
       * available policy and it invites kick-wars. Leaving is always allowed,
       * which is also what account deletion relies on (see services/account.ts,
       * which arrayRemoves the departing user from every chat).
       */
      function membershipChangeAllowed() {
        return removedMembers().size() == 0 ||
          removedMembers() == [request.auth.uid].toSet();
      }

      /**
       * Blocking is meant to stop a conversation starting. The app says so in
       * as many words — "You cannot start a chat with this user" — and until
       * now that was checked in one screen, client-side, and nowhere else: the
       * blocked party could create the chat directly and message through it.
       *
       * Scoped to two-party chats on purpose. A group is a different question
       * (blocking someone does not make either of you leave a room you are
       * both already in), and a rule that looked up a block for every member
       * would run past the per-request document-read limit at the group cap.
       * Checked in both directions, since either side blocking is a reason not
       * to open the conversation.
       */
      function blockedFromStarting(participants) {
        return participants.size() == 2 && (
          isBlocked(participants[0], participants[1]) ||
          isBlocked(participants[1], participants[0])
        );
      }

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        withinMemberCap(request.resource.data.participants) &&
        !blockedFromStarting(request.resource.data.participants);
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        withinMemberCap(request.resource.data.participants) &&
        membershipChangeAllowed();
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      // Recently-deleted messages, pending permanent removal.
      //
      // A deleted message is MOVED here rather than soft-flagged in place.
      // Flagging would have meant either leaving it in /messages (where the
      // other participant's client could still read it — "delete for everyone"
      // would have become a lie) or gating the read rule on a deleted field,
      // which breaks the thread query outright: Firestore rejects a whole query
      // when the read rule tests a field the query doesn't filter on. Moving it
      // keeps the thread query untouched and lets the rule below be strict.
      //
      // Only the person who deleted it may read, recover or purge it. The other
      // participant loses access the moment it lands here, so this is no weaker
      // than the previous hard delete from their side.
      match /trash/{messageId} {
        allow read, delete: if isChatParticipant(chatId) &&
          resource.data.deletedBy == request.auth.uid;
        allow create: if isChatParticipant(chatId) &&
          request.resource.data.deletedBy == request.auth.uid;
        // Never editable: a recovered message must be byte-identical to what
        // was deleted, so the only writes are create (delete) and delete
        // (recover/purge).
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // You may only create a message authored as yourself. The one exception
        // is a "missed call" system notice, which the *recipient* legitimately
        // writes on the caller's behalf: it must be flagged system + missed, use
        // the deterministic missed_<callId> id, and name a real participant as
        // the author — so the worst a forger could do is fake a missed-call.
        allow create: if isChatParticipant(chatId) && (
          request.resource.data.get('user', {}).get('_id', '') == request.auth.uid ||
          (
            request.resource.data.get('system', false) == true &&
            request.resource.data.get('call', {}).get('outcome', '') == 'missed' &&
            messageId.matches('missed_.*') &&
            request.resource.data.get('user', {}).get('_id', '') in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
        );

        function authorUid() {
          return resource.data.get('user', {}).get('_id', '');
        }

        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // Reactions are the one field every participant writes on someone
        // else's message as a matter of course.
        function isReactionChange() {
          return changedKeys().hasOnly(['reactions']);
        }

        /**
         * Burn-after-reading is recipient-driven by construction: the person
         * the message was sent to is the one who reveals it (stamping
         * burnStartedAt) and then wipes it. Both clients' burnMessage() clear
         * the content fields listed here.
         *
         * Gated on the message *already* carrying burnAfterReading — which is
         * written at send time, never later — so this cannot become a general
         * way to blank out an ordinary message. The encrypted* siblings are
         * listed because clearing them on burn is the obvious next fix (today
         * both clients leave the ciphertext behind, so a "burned" E2EE message
         * still sits on the server intact); the rule should not be what blocks
         * it.
         */
        function isBurnProgress() {
          return 'burnAfterReading' in resource.data &&
            changedKeys().hasOnly([
              'burnAfterReading',
              'text', 'image', 'video', 'videoDuration', 'audio', 'audioDuration',
              'file', 'linkPreview', 'moment',
              'encrypted', 'encryptedImage', 'encryptedVideo', 'encryptedAudio',
              'encryptedFileUri', 'encryptedLinkPreview',
            ]);
        }

        // Same shape: only the recipient marks a view-once message viewed, and
        // only on a message actually sent as view-once.
        /**
         * Recording that you opened a view-once message.
         *
         * The list may only grow by exactly you. Without that, any participant
         * could write whatever they liked into these three fields: add someone
         * else's uid so that person never gets their one view, or mark the
         * message expired before anyone had opened it. Neither reveals
         * anything, but both quietly destroy a message for its intended
         * audience, and the rule that allowed it existed only to let a viewer
         * record their own view.
         *
         * Set equality rather than "contains me" on purpose: it also stops
         * names being *removed*, which would hand back a second view.
         *
         * The Cloud Function (markViewOnceViewed) writes with the Admin SDK
         * and is not subject to this. It is the path that can null the media
         * out once every recipient has viewed, which a client cannot be
         * trusted to do for itself.
         */
        function isViewOnceMark() {
          return resource.data.get('viewOnce', false) == true &&
            changedKeys().hasOnly([
              'viewOnceViewedBy', 'viewOnceExpired', 'viewOnceOpenedAt',
            ]) &&
            request.resource.data.get('viewOnceViewedBy', []).toSet() ==
              resource.data.get('viewOnceViewedBy', []).toSet()
                .union([request.auth.uid].toSet());
        }

        /**
         * Everything above `create` goes to real trouble to stop you from
         * publishing a message authored as someone else. This rule used to be
         * `if isChatParticipant(chatId)`, which handed that straight back: any
         * member could edit any other member's message afterwards, and the
         * document still named the original author.
         *
         * E2EE does not cover this. A sealed message is opened with the
         * *sender's* public key, so a re-sealed forgery would fail to decrypt —
         * but the clients fall back to the plaintext `text` field whenever no
         * envelope is present (ChatScreen.tsx's isSealed() branch), so
         * overwriting a sealed message with plaintext renders it as the
         * victim's own words.
         *
         * So: the author may change their message however they like; everyone
         * else is limited to the three collaborative cases above.
         */
        allow update: if isChatParticipant(chatId) && (
          authorUid() == request.auth.uid ||
          isReactionChange() ||
          isBurnProgress() ||
          isViewOnceMark()
        );

        /**
         * Only the author may delete their own message.
         *
         * This was open to every participant, which meant one member of a
         * 32-person chat could destroy anyone's message — and irrecoverably
         * for its author, since only the *deleter* can restore from trash
         * (see the /trash rule above). The counterpart to narrowing it is the
         * report path below: the answer to someone else's message is to
         * report it, not to erase it.
         *
         * The system missed-call notice is the one message a non-author
         * legitimately removes, mirroring the create carve-out: it may be
         * written by the recipient on the caller's behalf, so it must be
         * removable by them too when the chat is cleared.
         */
        allow delete: if isChatParticipant(chatId) && (
          authorUid() == request.auth.uid ||
          (resource.data.get('system', false) == true && messageId.matches('missed_.*'))
        );
      }

      /**
       * Group sender-key distributions (services/groupRatchetMessages.ts).
       *
       * One document per (sender, recipient) pair, holding the sender's chain
       * key sealed with that pair's 1:1 ratchet session — so the payload is
       * ciphertext the server cannot read even though it stores it.
       *
       * Readable ONLY by the member it is addressed to. A chain key opens
       * every group message that sender goes on to write, so a rule allowing
       * any participant to read any distribution would hand a removed-then-
       * readded member, or anyone who briefly joined, the keys of everyone
       * else. Writable only by the sender it claims to be from, or a member
       * could plant a chain key of their own and have their messages accepted
       * as somebody else's.
       */
      match /senderKeys/{distributionId} {
        // The addressee, or the sender reading back their own. The second is
        // safe because they authored the contents — it is how a sender checks
        // whether a member already holds the current chain before re-sealing
        // it, and how rotation finds what to clean up. It grants no access to
        // anyone else's chain key.
        allow read: if isChatParticipant(chatId) && (
          resource.data.to == request.auth.uid ||
          resource.data.from == request.auth.uid
        );
        allow create, update: if isChatParticipant(chatId) &&
          request.resource.data.from == request.auth.uid &&
          request.resource.data.to is string;
        // Deleted on rotation, by the sender that wrote it.
        allow delete: if isChatParticipant(chatId) && resource.data.from == request.auth.uid;
      }

      match /calls/{callId} {
        allow read, write: if isChatParticipant(chatId);

        match /candidates/{candidateId} {
          allow read, write: if isChatParticipant(chatId);
        }
      }

      /**
       * A scheduled message is a message with a delay, so it carries the same
       * `user._id` and has to be held to the same rule: you may only author as
       * yourself.
       *
       * Nothing checked it. The messages rule below is careful about exactly
       * this — and processScheduledMessages copies a scheduled document into
       * that collection with the Admin SDK, which does not consult rules at
       * all. So scheduling was a way around the author check: any participant
       * could schedule a message naming another participant as its author, and
       * a minute later it appeared as theirs. In a messenger, a message
       * attributed to someone who did not write it is about the worst thing
       * that can be forged.
       *
       * The web client's own delivery path already refused to send one it did
       * not author ("only the author's client delivers"); this is that
       * instinct, enforced where it cannot be walked around.
       *
       * Update and delete are the author's too. An unrestricted update let a
       * participant rewrite the text of someone else's pending message, which
       * is the same forgery with an extra step.
       */
      function scheduledAuthor() {
        return request.resource.data.get('user', {}).get('_id', '');
      }

      match /scheduledMessages/{msgId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) &&
          scheduledAuthor() == request.auth.uid;
        allow update: if isChatParticipant(chatId) &&
          resource.data.get('user', {}).get('_id', '') == request.auth.uid &&
          scheduledAuthor() == request.auth.uid;
        allow delete: if isChatParticipant(chatId) &&
          resource.data.get('user', {}).get('_id', '') == request.auth.uid;
      }

      match /sharedLists/{listId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /expenses/{expenseId} {
        allow read, create: if isChatParticipant(chatId);
        allow update, delete: if isChatParticipant(chatId);
      }

      match /whiteboards/{whiteboardId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /quoteWall/{quoteId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /playlist/{trackId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /countdowns/{countdownId} {
        allow read, write: if isChatParticipant(chatId);
      }

      match /liveLocations/{userId} {
        allow read: if isChatParticipant(chatId);
        allow write: if isChatParticipant(chatId) && request.auth.uid == userId;
      }
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Owner-only private data (e.g. push/FCM tokens). Kept out of the public
    // /users profile doc, which any signed-in user can read. Cloud Functions use
    // the Admin SDK and bypass these rules.
    match /users/{userId}/private/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Published E2EE public keys. Readable by any signed-in user — that is what
    // "public key" means, and a peer must fetch yours to encrypt to you — but
    // writable only by the owner, so nobody can substitute their own key for
    // yours. The matching secret key never leaves the device.
    match /users/{userId}/publicKeys/{keyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * One-time prekeys for the forward-secrecy handshake (services/ratchetKeys.ts).
     *
     * Unusual shape: readable by anyone signed in, created and deleted only by
     * the owner, but *claimable* by anyone — a peer starting a conversation
     * marks one as taken so no second peer receives the same one. That claim
     * is the only write a non-owner may make, and it may flip `claimed` from
     * false to true and nothing else.
     *
     * The claim records only THAT a key was taken, never by whom. A
     * `claimedBy` field would hand the server a precise log of who started
     * talking to whom — exactly the metadata this app should be reducing — in
     * exchange for nothing, since the owner finds the matching secret by id in
     * its own storage.
     *
     * Known and accepted: any signed-in user can drain someone's batch by
     * claiming every key. That is griefing, not compromise — X3DH without a
     * one-time prekey is still authenticated and still forward-secret, losing
     * only replay resistance on the first message, and the owner republishes
     * when the count runs low. Refusing the handshake instead would turn this
     * into a way to block messaging to a user entirely, which is worse.
     */
    match /users/{userId}/oneTimePreKeys/{preKeyId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          resource.data.get('claimed', false) == false &&
          request.resource.data.claimed == true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['claimed', 'claimedAt'])
        )
      );
    }

    // Paid-subscription entitlement. Deliberately a TOP-LEVEL collection
    // rather than a field on /users/{uid} or a doc under /users/{uid}/private:
    // both of those grant the owner blanket write access (see the rules
    // above), so an entitlement living there could be self-granted with a
    // one-line write from the browser console. Rules are a permissive union —
    // a narrower `allow write: if false` does NOT revoke a broader allow — so
    // isolation, not nesting, is what makes this safe.
    //
    // Written exclusively by the Stripe webhook (functions/index.js) through
    // the Admin SDK, which bypasses rules entirely. No client, including the
    // owner, may write it.
    match /entitlements/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Invites ──────────────────────────────────────────────────────────
    //
    // Replaces lookup by email. The document id *is* the capability: 32 random
    // bytes, handed over out of band, and the only way to reach the document.
    //
    // `get` without `list` is the whole access model and the distinction is
    // load-bearing. A rule that allowed listing would let any signed-in user
    // read every pending invite in the system, which is a directory again —
    // exactly the thing this collection exists to remove.
    match /invites/{token} {
      function unexpired() {
        return request.resource.data.expiresAt is number
          && request.resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.expiresAt <= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000;
      }

      // Knowing the token is the authorisation. Still gated on being signed in,
      // so an unauthenticated scraper gets nothing even with a leaked link.
      allow get: if isSignedIn();
      allow list: if false;

      // Only for yourself, and only carrying what the recipient is about to
      // learn anyway. A name here would be a plaintext profile field again.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.inviterUid
        && request.resource.data.acceptedBy == null
        && request.resource.data.inviterKey is string
        && request.resource.data.keys().hasOnly(
             ['inviterUid', 'inviterKey', 'expiresAt', 'acceptedBy', 'createdAt'])
        && unexpired();

      // Single use, enforced here rather than in the client: accepting may only
      // stamp your own uid, only onto an invite nobody has claimed, and only
      // while it is live. Everything else about the document is immutable, so a
      // claimer cannot rewrite the key it points at.
      allow update: if isSignedIn()
        && resource.data.acceptedBy == null
        && resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.inviterUid == resource.data.inviterUid
        && request.resource.data.inviterKey == resource.data.inviterKey
        && request.resource.data.expiresAt == resource.data.expiresAt;

      // Withdrawing your own link. Not the recipient's to delete: an accepted
      // invite is the inviter's record that it was used.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.inviterUid;
    }
  }
}
