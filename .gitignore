# node.js
# Both forms: the trailing slash matches only directories, and a *symlink*
# named node_modules slips past it — which is how two absolute self-referential
# symlinks were committed and then handed to every clone.
node_modules/
node_modules
npm-debug.log
yarn-error.log

# fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# CocoaPods
/ios/Pods/
/macos-app/macos/Pods/
