rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasSession() {
      return request.auth != null && request.auth.token.sessionId is string;
    }

    function isActiveSession() {
      return hasSession() &&
        firestore.get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeSessionId ==
          request.auth.token.sessionId;
    }

    match /moments/{userId}/{allPaths=**} {
      allow read: if isActiveSession();
      allow write: if isActiveSession() && request.auth.uid == userId;
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if isActiveSession();
    }
  }
}

