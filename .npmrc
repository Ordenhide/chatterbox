# @react-native-oh-tpl/react-native-gesture-handler (added for the HarmonyOS
# port) declares a peer dependency on react-native-gesture-handler@2.14.1 —
# stale from whatever version it was built against — which conflicts with the
# ^2.20.2 the rest of the app depends on. Without this, `npm install` fails
# outright with ERESOLVE, even for plain iOS/Android work. The oh-tpl package
# still works fine against 2.20.2 in practice (see harmony/README.md's
# gesture-handler patch notes); the declared peer range is just wrong.
legacy-peer-deps=true
