# Copy to `functions/.env` and fill in. That file is gitignored — never commit
# real keys. For deploys, these same values must also exist as GitHub repo
# secrets, because .github/workflows/deploy-functions.yml rebuilds this file
# from them at deploy time (a gitignored file can't reach CI any other way).
#
# Every var here is optional in the sense that a missing one degrades one
# feature rather than breaking the deploy: index.js reads them lazily and the
# affected callable returns `failed-precondition` instead of crashing.

# ---- Chatterbox Pro billing (Stripe) ---------------------------------------
# Full setup walkthrough: see BILLING.md in the repo root.
#
# Prefer a RESTRICTED key (rk_…) over a secret key (sk_…) — it carries only the
# permissions you grant, so a leak does far less damage. BILLING.md lists the
# exact permissions this integration needs. Stay in test mode (rk_test_…) until
# the flow is verified end to end. Despite the var's name, an rk_ value is what
# belongs here. Without it, createCheckoutSession and createBillingPortalSession
# both reject with "Billing is not configured."
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…). This is NOT the API key — it's issued
# per-endpoint when you register the webhook (Dashboard → Developers →
# Webhooks → your endpoint → "Signing secret"), or printed by
# `stripe listen` for local testing. Without it stripeWebhook returns 500 and
# no subscription ever becomes an entitlement, so checkout would appear to
# succeed while Pro never activates.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…, NOT product IDs — a product id starts with prod_ and
# will fail at checkout). Dashboard → Product catalog → your product → pricing
# table → click a price → copy its ID. The client only ever sends the plan
# *name*; these map it server-side so a tampered client can't substitute a
# cheaper price.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# The web app's own origin. Two jobs: it's the fallback redirect target after
# checkout, and it's the allowlist that post-payment return URLs are checked
# against (origins must match exactly), so a tampered returnUrl can't turn the
# redirect into a phishing hop. Defaults to http://localhost:5173 when unset,
# which is correct for local dev but WILL break production checkout redirects
# if left blank there — set it to your deployed origin, no trailing slash.
#   e.g. APP_BASE_URL=https://chatterbox-e5d10.web.app
APP_BASE_URL=

# ---- AI chat / summaries (Cloudflare Workers AI) ---------------------------
# Cloudflare dashboard → Workers & Pages → Overview (account ID in the right
# sidebar), and My Profile → API Tokens for a token with Workers AI read
# access. Without these, summarizeChat / the AI reply features fail.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Scheduled functions (optional) ----------------------------------------
# Cloud Scheduler (pubsub) functions need the Blaze plan. They're stripped
# from exports unless this is exactly "true", so a project without billing
# can still deploy everything else. Flip on once Blaze is confirmed.
CHATTERBOX_ENABLE_SCHEDULED=

# ---- App Check enforcement (optional) --------------------------------------
# Rejects callable-function requests that carry no valid App Check token.
#
# Do NOT set this to "true" before the providers are registered in the Firebase
# console (App Attest or DeviceCheck for iOS, Play Integrity for Android) and a
# debug token exists for local builds. Enforcing first rejects every call from
# every client — an outage, not a degradation. See PROVISIONING.md.
CHATTERBOX_ENFORCE_APP_CHECK=
