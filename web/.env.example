# Copy to `.env.local` and fill in from Firebase Console → Project settings →
# Your apps → (your Web app) → SDK setup and configuration.
# If you don't set these, the app falls back to the values baked into
# src/firebase.ts — this project's own registered Web app. Set them to point a
# build at a different project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- App Check (optional) --------------------------------------------------
# Register a reCAPTCHA v3 provider (Firebase Console → App Check → your Web app)
# and paste the site key here to enable App Check. Leave blank to skip it
# (fine while App Check enforcement is in "monitor" mode).
VITE_RECAPTCHA_V3_SITE_KEY=
# For local dev against an *enforced* project, set a debug token (Console →
# App Check → Apps → Manage debug tokens). Any truthy value enables debug mode.
VITE_APPCHECK_DEBUG_TOKEN=

# TURN is not configured here. Both clients now mint a short-lived credential
# per call through the getTurnCredentials Cloud Function (services/call.ts) —
# see CALLING.md and functions/.env.example for where it's actually set up.

# ---- Web push (optional) ---------------------------------------------------
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# → "Key pair". Required for the Profile → Enable notifications button to work.
# NOTE: the config in public/firebase-messaging-sw.js must match your project.
VITE_FIREBASE_VAPID_KEY=

# ---- Native app downloads (optional) ---------------------------------------
# URLs the Profile → "Get the app" button links to for mobile. The button
# auto-detects the visitor's OS. Leave blank and that platform shows a "coming
# soon" message instead.
#   iOS      → App Store / TestFlight link
#   Android  → Play Store link or a direct .apk (see .github/workflows/release-apk.yml)
# macOS is NOT a native build — it installs the web app as a PWA (Chrome/Edge
# "Install", or Safari File → Add to Dock), so it needs no URL here.
VITE_DOWNLOAD_IOS=
VITE_DOWNLOAD_ANDROID=

# Local development only: skip reCAPTCHA for phone-number linking so the
# fictional numbers under Authentication → Sign-in method → Phone → "Numbers
# for testing" can be exercised. Real numbers still won't receive an SMS.
# Ignored entirely in production builds.
VITE_AUTH_DISABLE_APP_VERIFICATION=

# Local development only: point Functions + Firestore at
# `firebase emulators:start` instead of the real deployed backend — see
# BILLING.md. Auth stays real/production, so sign-in works normally but that
# account's chats/profile will look empty (the local emulator starts with no
# data of its own). Ignored entirely in production builds.
VITE_USE_FIREBASE_EMULATORS=
