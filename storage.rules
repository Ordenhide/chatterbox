rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasActiveSession() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.activeSessionId != null;
    }

    function isChatParticipant(chatId) {
      let chat = firestore.get(/databases/(default)/documents/chats/$(chatId));
      return chat != null && request.auth.uid in chat.data.participants;
    }

    match /moments/{userId}/{allPaths=**} {
      allow read: if hasActiveSession();
      allow write: if hasActiveSession() && request.auth.uid == userId;
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if hasActiveSession() && isChatParticipant(chatId);
    }
  }
}

