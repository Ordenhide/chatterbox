rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same session-currency check as firestore.rules' hasCurrentSession() —
    // see that file for the full reasoning (why comparing the sessionId
    // custom claim doesn't work: it's account-level, so any device's silent
    // background token refresh picks up whichever claim is current
    // regardless of who made it; auth_time is refresh-stable and only
    // changes on a real re-authentication, verified against the Auth
    // emulator rather than assumed). Kept consistent with that file's
    // fail-open default for an account with no claim recorded yet, rather
    // than this copy's previous stricter "activeSessionId must be set at
    // all" gate — having the two rules files disagree on what "no session
    // claimed yet" means would be its own bug.
    function hasCurrentSessionForUid(uid) {
      let path = /databases/(default)/documents/users/$(uid);
      let profile = firestore.get(path);
      return profile == null ||
        !('sessionClaimedAt' in profile.data) ||
        request.auth.token.auth_time >= profile.data.sessionClaimedAt.toMillis() / 1000 - 120;
    }

    function hasActiveSession() {
      return request.auth != null && hasCurrentSessionForUid(request.auth.uid);
    }

    function isChatParticipant(chatId) {
      let chat = firestore.get(/databases/(default)/documents/chats/$(chatId));
      return chat != null && request.auth.uid in chat.data.participants;
    }

    /**
     * Ceilings, not policy. Nothing here limited upload size at all, so one
     * authenticated participant could push arbitrarily many arbitrarily large
     * objects into the bucket — a billing and quota problem rather than a
     * confidentiality one, but the cheapest kind of abuse to carry out.
     *
     * Deliberately generous: chat media is uploaded without server-side
     * transcoding (a phone video goes up as recorded), so a tight cap would
     * reject real messages. These are sized to stop the abuse case, not to
     * enforce a product limit — that belongs in the client, where it can
     * explain itself to the user instead of failing with permission-denied.
     */
    function withinSize(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    /**
     * Blocks content types a browser would *execute* rather than display.
     *
     * A denylist rather than an allowlist on purpose: sending arbitrary
     * documents is a feature, so enumerating permitted types would break file
     * sharing the first time someone sent an unusual one. These four are the
     * ones that turn a storage bucket into a place to host script under a
     * URL the app itself hands out. An absent contentType is allowed — some
     * clients omit it — since without one nothing will execute either.
     */
    function isActiveContent() {
      return request.resource.contentType != null && (
        request.resource.contentType.matches('text/html.*') ||
        request.resource.contentType.matches('image/svg.*') ||
        request.resource.contentType.matches('application/xhtml.*') ||
        request.resource.contentType.matches('.*(javascript|ecmascript).*')
      );
    }

    // `request.resource` is null on a delete, and every check above reads it.
    // Guarding on that keeps deletion working without needing this ruleset to
    // depend on whether Storage supports granular create/update/delete verbs.
    function uploadAllowed(maxBytes) {
      return request.resource == null || (withinSize(maxBytes) && !isActiveContent());
    }

    function pairId(userA, userB) {
      return userA < userB ? userA + "_" + userB : userB + "_" + userA;
    }

    function isFriendOf(userA, userB) {
      return firestore.exists(/databases/(default)/documents/friends/$(pairId(userA, userB)));
    }

    function isBlockedBy(blockerId, blockedId) {
      return firestore.exists(
        /databases/(default)/documents/blocks/$(blockerId + "_" + blockedId));
    }

    /**
     * The same visibility test firestore.rules applies to the moment document,
     * applied to the object that document points at.
     *
     * These were not the same check, and the gap was the whole point of the
     * feature: Firestore correctly hid a private moment's document, while
     * Storage served the image to any signed-in user. `allow read` covers
     * `list` as well as `get`, and the old filenames were timestamps, so the
     * images did not even have to be guessed at — a stranger could enumerate
     * another account's moment media and download all of it, private ones
     * included, blocks ignored. Hiding the metadata while serving the content
     * protects nothing.
     *
     * Kept deliberately parallel to canReadMomentById in firestore.rules. If
     * one is ever changed, the other has to change with it, and the two files
     * cannot share code — which is exactly how they drifted apart to begin
     * with.
     */
    function canReadMoment(momentId) {
      let moment = firestore.get(/databases/(default)/documents/moments/$(momentId));
      return moment != null && (
        moment.data.authorId == request.auth.uid ||
        moment.data.visibility == "public" ||
        (moment.data.visibility == "friends" &&
          isFriendOf(request.auth.uid, moment.data.authorId))
      ) &&
      !isBlockedBy(request.auth.uid, moment.data.authorId) &&
      !isBlockedBy(moment.data.authorId, request.auth.uid);
    }

    // Moment media, addressed by the moment it belongs to so the rule can look
    // up that moment's visibility. The author is allowed unconditionally: the
    // object is uploaded before its document exists, and without this their
    // own upload would be unreadable until the document lands.
    match /moments/{userId}/{momentId}/{fileName} {
      allow read: if hasActiveSession() &&
        (request.auth.uid == userId || canReadMoment(momentId));
      // Writes are refused: Moments is gone from both clients, so nothing in
      // the app can produce an upload here. Left open it was a 25 MB-per-object
      // write channel into a path no screen renders and no sweep visits, billed
      // to this project. Reads stay so account deletion and data export can
      // still reach objects left behind by the feature — see firestore.rules.
      allow write: if false;
    }

    // Objects uploaded before the path carried a moment id. Nothing in the
    // path identifies which moment they belong to, so their visibility cannot
    // be determined — and the honest answer to "cannot determine" is no. The
    // author keeps access to their own; everyone else loses images on moments
    // posted before this change, which is the price of closing a hole that
    // exposed private ones to everybody. Writes are refused outright so no new
    // object can land somewhere unprotectable.
    match /moments/{userId}/{fileName} {
      allow read: if hasActiveSession() && request.auth.uid == userId;
      allow write: if false;
    }

    /**
     * Who uploaded an object, when the upload said so.
     *
     * Storage has no equivalent of a document's author field, so the clients
     * stamp `uploaderUid` as custom metadata and this is what reads it back.
     *
     * Absent is allowed, and that is the whole design constraint rather than
     * an oversight. Every object uploaded before this existed has no such
     * metadata, and so does every upload from a build already installed on
     * someone's phone — this app is distributed as an APK from chatterbox.fans,
     * not through a store that can force an update. Requiring the stamp would
     * have stopped those clients attaching anything at all, which is a worse
     * outcome than the griefing it prevents. The protection therefore arrives
     * as clients update, and an object without a stamp behaves as it did
     * before.
     */
    function uploaderIsMe() {
      return resource == null ||
        resource.metadata == null ||
        !('uploaderUid' in resource.metadata) ||
        resource.metadata.uploaderUid == request.auth.uid;
    }

    /** An upload may decline to say who made it; it may not name someone else. */
    function uploaderClaimHonest() {
      return request.resource == null ||
        request.resource.metadata == null ||
        !('uploaderUid' in request.resource.metadata) ||
        request.resource.metadata.uploaderUid == request.auth.uid;
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read: if hasActiveSession() && isChatParticipant(chatId);

      /**
       * Create and destroy are separated because they were not, and the
       * asymmetry with Firestore was stark: the message rule there was
       * deliberately narrowed to "only the author may delete their own
       * message", with the reasoning written out — one member of a 32-person
       * chat could otherwise destroy anyone's message, irrecoverably for its
       * author. The bytes behind those messages had no such rule. `read`
       * covers `list`, so the object names were discoverable too, and any
       * participant could delete or overwrite another's attachment.
       *
       * Overwriting is `update` and is gated on the *existing* object's
       * stamp, so it cannot be used to strip the metadata and then delete.
       *
       * Higher size ceiling than moments because this path also carries video
       * and arbitrary documents.
       */
      /*
       * `uploaderIsMe()` is on `create` as well as `update`, and that is not
       * belt-and-braces: writing new bytes over an existing object is a
       * *create* in Storage rules, not an update — `update` covers a metadata
       * change. Measured against the emulator rather than assumed, after the
       * first version of this rule put the check only on `update` and the
       * overwrite test said it had succeeded.
       *
       * On a genuine new upload `resource` is null and the check passes, so
       * the ordinary path is unaffected.
       */
      allow create: if hasActiveSession() && isChatParticipant(chatId) &&
        uploadAllowed(200 * 1024 * 1024) && uploaderClaimHonest() && uploaderIsMe();
      allow update: if hasActiveSession() && isChatParticipant(chatId) &&
        uploadAllowed(200 * 1024 * 1024) && uploaderClaimHonest() && uploaderIsMe();
      allow delete: if hasActiveSession() && isChatParticipant(chatId) && uploaderIsMe();
    }
  }
}

