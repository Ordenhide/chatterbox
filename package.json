{
  "name": "chatterbox",
  "version": "1.2.0",
  "description": "An end-to-end encrypted messenger with no phone number, no email address and no user directory",
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "postinstall": "patch-package",
    "firebase": "firebase",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-chatterbox-rules-test \"jest --config test/rules/jest.config.js\"",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-chatterbox-auth-test \"cd web && npx vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-clipboard/clipboard": "^1.13.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-native-firebase/app": "26.2.0",
    "@react-native-firebase/app-check": "26.2.0",
    "@react-native-firebase/auth": "26.2.0",
    "@react-native-firebase/firestore": "26.2.0",
    "@react-native-firebase/functions": "26.2.0",
    "@react-native-firebase/messaging": "26.2.0",
    "@react-native-firebase/remote-config": "26.2.0",
    "@react-native-firebase/storage": "26.2.0",
    "@react-native-oh-tpl/async-storage": "^1.21.0-0.2.2",
    "@react-native-oh-tpl/clipboard": "^1.13.2-0.0.9",
    "@react-native-oh-tpl/flash-list": "^1.6.3-0.2.8",
    "@react-native-oh-tpl/geolocation": "^3.1.0-0.0.7",
    "@react-native-oh-tpl/netinfo": "^11.1.0-0.0.8",
    "@react-native-oh-tpl/react-native-audio-recorder-player": "^3.6.10-0.0.2",
    "@react-native-oh-tpl/react-native-blob-util": "^0.19.7-rc.1",
    "@react-native-oh-tpl/react-native-document-picker": "^9.2.0-0.0.2",
    "@react-native-oh-tpl/react-native-gesture-handler": "^2.14.17-rc.0",
    "@react-native-oh-tpl/react-native-get-random-values": "^1.11.0-0.0.1",
    "@react-native-oh-tpl/react-native-haptic-feedback": "^2.2.0-0.0.1",
    "@react-native-oh-tpl/react-native-image-picker": "^7.0.3-0.1.7",
    "@react-native-oh-tpl/react-native-image-resizer": "^3.0.9-0.0.3",
    "@react-native-oh-tpl/react-native-image-viewing": "^0.2.2-0.0.4",
    "@react-native-oh-tpl/react-native-incall-manager": "^4.2.0-0.0.4",
    "@react-native-oh-tpl/react-native-linear-gradient": "^3.0.0-0.5.0",
    "@react-native-oh-tpl/react-native-localize": "^3.1.0-0.0.1",
    "@react-native-oh-tpl/react-native-safe-area-context": "^4.7.4-0.2.1",
    "@react-native-oh-tpl/react-native-screens": "^3.34.0-0.0.1",
    "@react-native-oh-tpl/react-native-svg": "^15.0.1-8",
    "@react-native-oh-tpl/react-native-video": "^5.2.6",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@scure/bip39": "^2.2.0",
    "firebase": "^11.1.0",
    "i18next": "^23.12.2",
    "link-preview-js": "^3.1.0",
    "react": "19.2.3",
    "react-i18next": "^13.5.0",
    "react-native": "0.84.1",
    "react-native-audio-recorder-player": "^3.6.2",
    "react-native-biometrics": "^3.0.1",
    "react-native-blob-util": "^0.24.10",
    "react-native-document-picker": "^9.3.1",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-chat": "2.4.0",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-image-picker": "^7.1.0",
    "react-native-image-resizer": "^1.4.5",
    "react-native-image-viewing": "^0.2.2",
    "react-native-incall-manager": "^4.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-localize": "^3.0.3",
    "react-native-mmkv": "^4.1.1",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-screens": "^4.7.0",
    "react-native-svg": "^15.15.3",
    "react-native-video": "^6.2.0",
    "react-native-webrtc": "^124.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/runtime": "^7.23.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-oh/react-native-harmony": "^0.84.2",
    "@react-native-oh/react-native-harmony-cli": "^0.84.2",
    "@react-native/eslint-config": "^0.84.1",
    "@react-native/metro-config": "^0.84.1",
    "@react-native/typescript-config": "^0.84.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.9",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.54.0",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^15.5.1",
    "jest": "^29.7.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@noble|@scure)/)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/web/",
      "<rootDir>/macos-app/",
      "<rootDir>/harmony/",
      "<rootDir>/functions/",
      "<rootDir>/test/rules/",
      "<rootDir>/ml/"
    ]
  }
}
