+/**
+ * HarmonyOS build of ImageItem.
+ *
+ * react-native-image-viewing ships only ImageItem.ios.js and
+ * ImageItem.android.js with no platform-agnostic fallback, so Metro cannot
+ * resolve this import at all on a third platform. The two variants differ only
+ * in how they drive pan/zoom; the iOS one is written entirely against
+ * cross-platform primitives (Animated, ScrollView, Dimensions), so it is the
+ * portable one.
+ */
+export {default} from './ImageItem.ios';
