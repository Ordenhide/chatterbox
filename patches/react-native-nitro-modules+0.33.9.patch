+    Date() = delete;
+    ~Date() = delete;
+
+    static jsi::Value callConstructor(jsi::Runtime& runtime, double msSinceEpoch);
+    static bool isInstanceOf(jsi::Runtime& runtime, const jsi::Object& object);
