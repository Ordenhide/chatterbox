@@ -0,0 +1,12 @@
+/**
+ * Compatibility shim for the pre-v4 GHContext path.
+ *
+ * @react-native-oh-tpl/react-native-screens (based on upstream v3.34, the
+ * newest version with a HarmonyOS port) does a deep import of
+ * 'react-native-screens/src/native-stack/contexts/GHContext'. Our real
+ * react-native-screens is v4.23, where GHContext moved to '../../contexts'
+ * during a refactor — same export, new location. This restores the old path
+ * rather than patching the oh-tpl package, since the oh-tpl source is
+ * upstream-maintained and this is the smaller, more targeted fix.
+ */
+export {GHContext} from '../../contexts';
